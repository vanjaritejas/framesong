# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API (or "API Keys")

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Called the "publishable" key in newer dashboards (starts with sb_publishable_).
# Older projects call it the "anon public" key. Either one works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Added on later days (keep these secret, never prefix with NEXT_PUBLIC_):
# ANTHROPIC_API_KEY=
# FAL_KEY=
# SUPABASE_SECRET_KEY=
